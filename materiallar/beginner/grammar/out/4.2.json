 "intro": {
  "what": "Possessive 's (Qaratqich 's) otga -'s qo'shish orqali narsa yoki shaxs kimga tegishli ekanini bildiradi. Shuningdek, u 'is' qisqartmasi sifatida ham ishlatiladi.",
  "when": [
   "Birlikdagi otlarga egalikni bildirish uchun (Tom's book)",
   "Ism va qarindoshlik nomlari bilan foydalanish (my sister's car)",
   "He is yoki Who is so'zlarining qisqartmasi sifatida (He's a doctor)",
   "Savollarda kimga tegishli ekanini so'rash uchun (Whose bag is this?)"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + OB + 's + OB",
    "example_en": "This is John's car.",
    "example_uz": "Bu Jonning mashinasi."
   },
   {
    "label": "(-)",
    "formula": "S + TOBE + NOT + OB + 's + OB",
    "example_en": "This is not Ali's book.",
    "example_uz": "Bu Alining kitobi emas."
   },
   {
    "label": "(?)",
    "formula": "TOBE + S + OB + 's + OB?",
    "example_en": "Is this Malika's house?",
    "example_uz": "Bu Malikaning uyiymi?"
   },
   {
    "label": "Wh-",
    "formula": "WH + TOBE + S + 's?",
    "example_en": "Whose pen is this?",
    "example_uz": "Bu kimning ruchkasi?"
   }
  ],
  "rules": [
   {
    "title": "Birlikdagi otlar uchun 's",
    "text": "Birlikdagi ism yoki otlardan keyin apostrof va s ('s) qo'shiladi.",
    "examples": [
     {
      "en": "Tom's dog is big.",
      "uz": "Tomning iti katta."
     },
     {
      "en": "My brother's friend is nice.",
      "uz": "Akamning do'sti yaxshi."
     }
    ]
   },
   {
    "title": "'s har xil ma'noda",
    "text": "'s qaratqich kelishigini ham, 'is' fe'lini ham bildiradi.",
    "examples": [
     {
      "en": "He's a doctor.",
      "uz": "U shifokor. (He is)"
     },
     {
      "en": "Ali's car is new.",
      "uz": "Alining mashinasi yangi. (Possessive 's)"
     }
    ]
   }
  ],
