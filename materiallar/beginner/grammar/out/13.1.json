 "intro": {
  "what": "Present Continuous (hozir bo'layotgan ish-harakat) – ayni damda sodir bo'layotgan ish-harakatlarni bildiradi. Buni yasash uchun am, is, are va fe'lga -ing qo'shimchasini qo'shamiz.",
  "when": [
   "Ayni damda bo'layotgan ish-harakatlar uchun (Actions happening now)",
   "Vaqtinchalik holatlar uchun (Temporary situations)",
   "Jarayondagi ishlar uchun (Process)",
   "Kelajakdagi kelishilgan rejalar uchun (Future arrangements)"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "[ S + am/is/are + V-ing + OB ]",
    "example_en": "I am reading a book.",
    "example_uz": "Men kitob o'qiyapman."
   },
   {
    "label": "(-)",
    "formula": "[ S + am/is/are + not + V-ing + OB ]",
    "example_en": "They aren't working.",
    "example_uz": "Ular ishlamayapti."
   },
   {
    "label": "(?)",
    "formula": "[ Am/Is/Are + S + V-ing + OB? ]",
    "example_en": "Is it raining?",
    "example_uz": "Yomg'ir yog'yaptimi?"
   },
   {
    "label": "Wh-",
    "formula": "[ WH + am/is/are + S + V-ing + OB? ]",
    "example_en": "What are you doing?",
    "example_uz": "Siz nima qilyapsiz?"
   }
  ],
  "rules": [
   {
    "title": "Imlo qoidasi (-e)",
    "text": "Agar fe'l 'e' harfi bilan tugasa, -ing qo'shishdan oldin 'e' tushib qoladi.",
    "examples": [
     {
      "en": "make -> making",
      "uz": "yasamoq -> yasayapti"
     },
     {
      "en": "write -> writing",
      "uz": "yozmoq -> yozayapti"
     }
    ]
   },
   {
    "title": "Undosh harfning ikkilanishi",
    "text": "Bir bo'g'inli fe'llar oxirida qisqa unli + bitta undosh kelsa, oxirgi harf ikkilanadi.",
    "examples": [
     {
      "en": "run -> running",
      "uz": "yugurmoq -> yugurayapti"
     },
     {
      "en": "sit -> sitting",
      "uz": "o'tirmoq -> o'tiribdi"
     }
    ]
   },
   {
    "title": "Tobe fe'lini tanlash",
    "text": "Ega kishilik olmoshiga qarab am, is yoki are ishlatiladi: I am, He/She/It is, We/You/They are.",
    "examples": [
     {
      "en": "She is wearing a red dress.",
      "uz": "U qizil ko'ylak kiyib olgan."
     },
     {
      "en": "We are listening to music.",
      "uz": "Biz musiqa tinglayapmiz."
     }
    ]
   }
  ],
  "signal_words": [
