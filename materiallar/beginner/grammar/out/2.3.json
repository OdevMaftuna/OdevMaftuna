 "intro": {
  "what": "What, where va how so'roq so'zlari yordamida ism, yosh, qayerdan ekanligi va ahvol haqida savollar tuzamiz. Ingliz tilida savol gapda so'z tartibi: so'roq so'z + to be (am/is/are) + ega shaklida bo'ladi.",
  "when": [
   "Ism so'rashda (What's your name?)",
   "Qayerdan ekanligini so'rashda (Where are you from?)",
   "Ahvol so'rashda (How are you?)",
   "Yosh so'rashda (How old are you?)"
  ],
  "structures": [
   {
    "label": "Wh- Question (+) What",
    "formula": "WHAT + TOBE + S + OB?",
    "example_en": "What is your name?",
    "example_uz": "Ismingiz nima?"
   },
   {
    "label": "Wh- Question (+) Where",
    "formula": "WHERE + TOBE + S + FROM?",
    "example_en": "Where are you from?",
    "example_uz": "Siz qayerdansiz?"
   },
   {
    "label": "Wh- Question (+) How",
    "formula": "HOW + TOBE + S?",
    "example_en": "How are you?",
    "example_uz": "Ahvolingiz qanday?"
   },
   {
    "label": "Wh- Question (+) Age",
    "formula": "HOW OLD + TOBE + S?",
    "example_en": "How old are you?",
    "example_uz": "Yoshingiz nechada?"
   }
  ],
  "rules": [
   {
    "title": "So'z tartibi qoidasi",
    "text": "Savol gaplarda so'roq so'z doim boshida keladi, undan keyin to be (am/is/are) va keyin ega qo'yiladi.",
    "examples": [
     {
      "en": "Where is she from?",
      "uz": "U qayerdan?"
     },
     {
      "en": "What is his name?",
      "uz": "Uning ismi nima?"
     }
    ]
   },
   {
    "title": "Qisqartmalar (Contractions)",
    "text": "What is so'zini What's deb qisqartirish mumkin.",
    "examples": [
     {
      "en": "What's your name?",
      "uz": "Ismingiz nima?"
     },
     {
      "en": "What's her name?",
      "uz": "Uning ismi nima?"
     }
    ]
   },
   {
    "title": "Egalik sifatlari mos kelishi",
    "text": "O'g'il bolalar uchun his, qiz bolalar uchun her egalik sifati ishlatiladi.",
    "examples": [
     {
      "en": "What is his name?",
      "uz": "Uning ismi nima? (o'g'il bola)"
     },
     {
      "en": "What is her name?",
      "uz": "Uning ismi nima? (qiz bola)"
     }
    ]
   }
  ],
  "signal_words": [
   {
    "en": "What",
    "uz": "Nima"
   },
   {
    "en": "Where",
    "uz": "Qayerda / Qayerdan"
   },
   {
    "en": "How",
    "uz": "Qanday / Necha"
   }
  ],
