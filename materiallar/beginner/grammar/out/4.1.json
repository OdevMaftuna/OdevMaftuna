 "intro": {
  "what": "Egalik sifatlari (Possessive adjectives) narsaning kimgadir tegishliligini bildiradi. Ular doim ot so'z turkumidan oldin keladi.",
  "when": [
   "Buyum kimga tegishli ekanini ko'rsatish uchun",
   "Oila a'zolari va tanishlarni tanishtirishda",
   "Shaxsiy buyumlar va o'rin-joylarni atashda"
  ],
  "structures": [
   {
    "label": "(+) Darak",
    "formula": "S + TOBE + POSSESSIVE ADJECTIVE + OB",
    "example_en": "This is our school.",
    "example_uz": "Bu bizning maktabimiz."
   },
   {
    "label": "(-) Inkor",
    "formula": "S + TOBE + NOT + POSSESSIVE ADJECTIVE + OB",
    "example_en": "This is not my book.",
    "example_uz": "Bu mening kitobim emas."
   },
   {
    "label": "(?) So'roq",
    "formula": "TOBE + S + POSSESSIVE ADJECTIVE + OB?",
    "example_en": "Is this your car?",
    "example_uz": "Bu sening mashinangmi?"
   }
  ],
  "rules": [
   {
    "title": "Ot bilan ishlatilishi",
    "text": "Egalik sifatlaridan (my, your, his, her, its, our, their) keyin albatta ot kelishi shart. Ulardan keyin yolg'iz o'zi kelib qolmaydi.",
    "examples": [
     {
      "en": "My bag is big.",
      "uz": "Mening sumkam katta."
     },
     {
      "en": "Your house is new.",
      "uz": "Sening uying yangi."
     }
    ]
   },
   {
    "title": "Jinsga moslashish",
    "text": "His faqat o'g'il bola (erkak) uchun, her esa qiz bola (ayol) uchun ishlatiladi. Its esa jonivorlar va narsalar uchun qo'llaniladi.",
    "examples": [
     {
      "en": "His name is Aziz.",
      "uz": "Uning ismi Aziz."
