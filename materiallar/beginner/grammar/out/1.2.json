 "intro": {
  "what": "Egalik sifatlari (my, your) narsaning kimgacha tegishli ekanligini bildiradi. Ular doim ot so'z turkumidan oldin ishlatiladi.",
  "when": [
   "O'zimizga tegishli narsalar haqida gapirganda (my bag)",
   "Suhbatdoshimizga tegishli narsalar haqida gapirganda (your book)",
   "Ism va familiya so'raganda va aytganda (What's your name? My name is ...)",
   "Kundalik tanishuv va muloqotda"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + POSSESSIVE ADJECTIVE + OB",
    "example_en": "My name is Tom.",
    "example_uz": "Mening ismim Tom."
   },
   {
    "label": "(?)",
    "formula": "WHAT + TOBE + POSSESSIVE ADJECTIVE + NAME?",
    "example_en": "What is your name?",
    "example_uz": "Sizning ismingiz nima?"
   },
   {
    "label": "(+) Your",
    "formula": "POSSESSIVE ADJECTIVE + OB",
    "example_en": "This is your book.",
    "example_uz": "Bu sizning kitobingiz."
   }
  ],
  "rules": [
   {
    "title": "Ot-oldidan kelishi",
    "text": "Egalik sifatlari (my, your) doim o'zidan keyin ot so'z turkumini talab qiladi va ulardan keyin boshqa so'z qo'shilmaydi.",
    "examples": [
     {
      "en": "My bag",
      "uz": "Mening sumkam"
     },
     {
      "en": "Your car",
      "uz": "Sizning mashinangiz"
     }
    ]
   },
   {
    "title": "What is qisqartmasi",
    "text": "Og'zaki nutqda va yozuvda 'What is' ko'pincha 'What's' tarzida qisqartiriladi.",
    "examples": [
     {
      "en": "What's your name?",
      "uz": "Ismingiz nima?"
     },
     {
      "en": "What's this?",
      "uz": "Bu nima?"
     }
    ]
   }
  ],
  "signal_words": [],
  "mistakes": [
   {
    "wrong": "This is mine book.",
    "right": "This is my book.",
    "why": "Egalik sifatidan keyin ot kelsa 'my' ishlatiladi, 'mine' esa ot kelmaganda ishlatiladi."
   },
   {
    "wrong": "What is you name?",
    "right": "What is your name?",
    "why": "Sizning demoqchi bo'lsak 'you' emas, 'your' egalik sifatini qo'llashimiz kerak."
   },
   {
    "wrong": "My is Ali.",
    "right": "My name is Ali.",
    "why": "Egalik sifatidan keyin albatta ot (name) kelishi shart."
   }
  ]
 },
