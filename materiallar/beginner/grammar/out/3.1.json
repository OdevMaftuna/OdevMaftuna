 "intro": {
  "what": "Verb to be ning inkor shakli (I'm not, isn't, aren't) gapda biror narsa yoki holatning yo'qligini, to'g'ri emasligini bildirish uchun ishlatiladi.",
  "when": [
   "Kasbni inkor qilishda (I'm not a doctor)",
   "Millat yoki joyni inkor qilishda (They aren't from Spain)",
   "Holat va sifatlarni inkor qilishda (She isn't married)"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + OB",
    "example_en": "I am a student.",
    "example_uz": "Men talabaman."
   },
   {
    "label": "(-)",
    "formula": "S + TOBE + NOT + OB",
    "example_en": "I'm not a teacher.",
    "example_uz": "Men o'qituvchi emasman."
   },
   {
    "label": "(- he/she/it)",
    "formula": "HE / SHE / IT + ISN'T + OB",
    "example_en": "She isn't married.",
    "example_uz": "U turmushga chiqmagan."
   },
   {
    "label": "(- we/you/they)",
    "formula": "WE / YOU / THEY + AREN'T + OB",
    "example_en": "They aren't from Spain.",
    "example_uz": "Ular Ispaniyadan emas."
   }
  ],
  "rules": [
   {
    "title": "Qisqartma shakllar",
    "text": "Inkor gaplarda tobe fe'li va not so'zi ko'pincha qisqartirib yoziladi va og'zaki nutqda ishlatiladi.",
    "examples": [
     {
      "en": "He is not a doctor -> He isn't a doctor.",
      "uz": "U doktor emas."
     },
     {
      "en": "They are not from London -> They aren't from London.",
      "uz": "Ular Londondan emas."
     }
    ]
   },
   {
    "title": "I olmoshining inkor shakli",
    "text": "I olmoshidan keyin faqat 'am not' ishlatiladi, 'amn't' deb yozib bo'lmaydi.",
    "examples": [
     {
      "en": "I'm not tired today.",
      "uz": "Men bugun charchagan emasman."
     },
     {
      "en": "I'm not a businessman.",
      "uz": "Men tadbirkor emasman."
     }
    ]
   }
  ],
