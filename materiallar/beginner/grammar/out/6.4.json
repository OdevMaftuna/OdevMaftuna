  ],
  "structures": [
   {
    "label": "AT formula",
    "formula": "at + clock time / night / weekend",
    "example_en": "I get up at 7 o'clock.",
    "example_uz": "Men soat 7 da turaman."
   },
   {
    "label": "ON formula",
    "formula": "on + day / date",
    "example_en": "We work on Monday.",
    "example_uz": "Biz dushanba kuni ishlaymiz."
   },
   {
    "label": "IN formula",
    "formula": "in + month / year / season / part of day",
    "example_en": "She visits us in summer.",
    "example_uz": "U bizga yozda tashrif buyuradi."
   }
  ],
  "rules": [
   {
    "title": "Clock time va maxsus so'zlar",
