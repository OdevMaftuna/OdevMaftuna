   "Inkor gaplarda narsa yo'qligini bildirish uchun any ishlatiladi.",
   "So'roq gaplarda any ishlatiladi."
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "[ S + HAVE + SOME + OB ]",
    "example_en": "I have some bread.",
    "example_uz": "Mening ozgina nonim bor."
   },
   {
    "label": "Offers",
    "formula": "[ WOULD YOU LIKE + SOME + OB ]",
    "example_en": "Would you like some tea?",
    "example_uz": "Choy xohlaysizmi?"
   },
   {
    "label": "(-)",
    "formula": "[ S + DO/DOES + NOT + HAVE + ANY + OB ]",
