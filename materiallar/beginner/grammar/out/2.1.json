 "intro": {
  "what": "Bu mavzu Uchinchi shaxs birlik va ko'plikda (he, she, they) 'to be' fe'lining am, is, are shakllarini ishlatishni o'rgatadi. Ular kasb, joy va davlatlarni aytishda ishlatiladi.",
  "when": [
   "Kasbni aytganda (She's a doctor)",
   "Joyni aytganda (They're in Tashkent)",
   "Davlatni aytganda (He's from England)"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + OB",
    "example_en": "He is a student.",
    "example_uz": "U talaba."
   },
   {
    "label": "(-)",
    "formula": "S + TOBE + NOT + OB",
    "example_en": "She isn't a doctor.",
    "example_uz": "U shifokor emas."
   },
   {
    "label": "(?)",
    "formula": "TOBE + S + OB",
    "example_en": "Are they from Brazil?",
    "example_uz": "Ular Braziliyadanmi?"
   },
   {
    "label": "Qisqa javob",
    "formula": "Yes, S + TOBE / No, S + TOBE + NOT",
    "example_en": "Yes, he is.",
    "example_uz": "Ha, u."
   }
  ],
  "rules": [
   {
    "title": "Kishish olmoshlari va to be",
    "text": "He va she uchun 'is' ishlatiladi. They uchun 'are' ishlatiladi.",
    "examples": [
     {
      "en": "He is from Samarkand.",
      "uz": "U Samarqanddan."
