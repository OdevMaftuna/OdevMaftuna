 "intro": {
  "what": "Otning ko'plik shakli (Plural nouns) ingliz tilida bir nechta narsa yoki shaxslarni bildirish uchun ishlatiladi. Ko'pgina otlarga -s yoki -es qo'shimchasi qo'shiladi.",
  "when": [
   "Bitta narsani ko'p qilishda (-s qo'shiladi)",
   "Oxiri s, ss, sh, ch, x bilan tugagan so'zlarda (-es qo'shiladi)",
   "Sonlar bilan birga ishlatilganda (two books)"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "[ S + PLURAL NOUN ]",
    "example_en": "I have two books.",
    "example_uz": "Menda ikkita kitob bor."
   },
   {
    "label": "(-)",
    "formula": "[ THERE ARE + NOT + PLURAL NOUN ]",
    "example_en": "There are not two books.",
    "example_uz": "Bu yerda ikkita kitob yo'q."
   },
   {
    "label": "(?)",
    "formula": "[ ARE + THERE + PLURAL NOUN ? ]",
    "example_en": "Are there two books?",
    "example_uz": "Bu yerda ikkita kitob bormi?"
   }
  ],
  "rules": [
   {
    "title": "Oddiy ko'plik (-s)",
    "text": "Ko'pgina otlarning oxiriga shunchaki -s qo'shiladi.",
    "examples": [
     {
      "en": "book - books",
      "uz": "kitob - kitoblar"
     },
     {
      "en": "camera - cameras",
      "uz": "kamera - kameralar"
     }
    ]
   },
   {
    "title": "-es qo'shimchasi",
    "text": "Agar ot s, ss, sh, ch, x bilan tugasa, oxiriga -es qo'shiladi.",
    "examples": [
     {
      "en": "bus - buses",
      "uz": "avtobus - avtobuslar"
     },
     {
      "en": "watch - watches",
      "uz": "soat - soatlar"
     }
    ]
   },
   {
    "title": "Sonlar bilan ishlatish",
    "text": "Sonlardan keyin keladigan otlar har doim ko'plik shaklida bo'ladi.",
    "examples": [
     {
      "en": "two books",
      "uz": "ikkita kitob"
     },
     {
