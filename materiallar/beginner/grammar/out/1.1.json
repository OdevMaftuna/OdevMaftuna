 "intro": {
  "what": "Am / are / is (to be fe'li) — bu ingliz tilida 'bo'lmoq' ma'nosini bildiruvchi fe'l bo'lib, gapda asosiy fe'l bo'lmaganda ism, kasb, joy va holatlarni bildirish uchun ishlatiladi.",
  "when": [
   "Ism va tanishuvni aytishda",
   "Ahvol va holatni bildirishda",
   "Shaxs va narsalarni ko'rsatishda"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + OB",
    "example_en": "I am Ben.",
    "example_uz": "Men Benman."
   },
   {
    "label": "(-)",
    "formula": "S + TOBE + NOT + OB",
    "example_en": "You are not Ben.",
    "example_uz": "Sen Ben emassan."
   },
   {
    "label": "(?)",
    "formula": "TOBE + S + OB",
    "example_en": "Are you Mika?",
    "example_uz": "Sen Mikaeatsanmi?"
   },
   {
    "label": "Wh-",
    "formula": "WH + TOBE + S",
    "example_en": "What is your name?",
    "example_uz": "Ismingiz nima?"
   }
  ],
  "rules": [
   {
    "title": "To be shakllari",
    "text": "Egalarga qarab to be fe'li o'zgaradi: I uchun am, you uchun are, it uchun is ishlatiladi.",
