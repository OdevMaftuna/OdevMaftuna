  "structures": [
   {
    "label": "(+) Birlik",
    "formula": "[ This / That + IS + OB ]",
    "example_en": "This is my car.",
    "example_uz": "Bu mening mashinam."
   },
   {
    "label": "(+) Ko'plik",
    "formula": "[ These / Those + ARE + OB ]",
