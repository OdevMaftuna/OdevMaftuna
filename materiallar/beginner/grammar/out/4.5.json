 "intro": {
  "what": "Egalik olmoshlari (Possessive pronouns: mine, yours, his, hers, ours, theirs) narsa kimga tegishli ekanini bildiradi. Ular yolg'iz ishlatiladi va o'zidan keyin ot olmaydi.",
  "when": [
   "Narsaning egasini ko'rsatish va gapni oxirida ishlatish uchun",
   "Egalik sifatini qisqartirib, otni tushirib qoldirganda",
   "Kimning narsasi ekanini so'rash va javob berishda"
  ],
  "structures": [
   {
    "label": "(+)",
    "formula": "S + TOBE + POSSESSIVE PRONOUN",
    "example_en": "This book is mine.",
    "example_uz": "Bu kitob meniki."
   },
   {
    "label": "(-)",
    "formula": "S + TOBE + NOT + POSSESSIVE PRONOUN",
    "example_en": "This bag isn't yours.",
    "example_uz": "Bu sumka seniki emas."
   },
   {
    "label": "(?)",
    "formula": "TOBE + S + POSSESSIVE PRONOUN?",
    "example_en": "Is this car hers?",
    "example_uz": "Bu mashina uniki (qizniki)mi?"
   },
   {
    "label": "(Wh-)",
    "formula": "Whose + OB + TOBE + S?",
    "example_en": "Whose camera is this?",
    "example_uz": "Bu kimning kamerasidir?"
   }
  ],
  "rules": [
   {
    "title": "Egalik sifati va olmoshi farqi",
    "text": "Egalik sifatidan (my, your) keyin ot keladi (my book). Egalik olmoshidan (mine, yours) keyin esa hech qanday ot kelmaydi va ular yolg'iz keladi.",
    "examples": [
     {
      "en": "This is my car.",
      "uz": "Bu mening mashinam."
     },
     {
      "en": "This car is mine.",
      "uz": "Bu mashina meniki."
     }
    ]
   },
   {
    "title": "His olmoshi o'zgarmaydi",
